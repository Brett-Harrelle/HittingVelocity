DROP VIEW IF EXISTS Player_Leaderboard;

CREATE VIEW Player_Leaderboard AS
WITH Thresholds AS (
    SELECT '90+' VelocityThreshold,'Cumulative' ThresholdType,90 MinB,999 MaxB UNION ALL
    SELECT '91+','Cumulative',91,999 UNION ALL SELECT '92+','Cumulative',92,999 UNION ALL
    SELECT '93+','Cumulative',93,999 UNION ALL SELECT '94+','Cumulative',94,999 UNION ALL
    SELECT '95+','Cumulative',95,999 UNION ALL SELECT '96+','Cumulative',96,999 UNION ALL
    SELECT '97+','Cumulative',97,999 UNION ALL SELECT '98+','Cumulative',98,999 UNION ALL
    SELECT '99+','Cumulative',99,999 UNION ALL SELECT '100+','Cumulative',100,999 UNION ALL
    SELECT '101+','Cumulative',101,999 UNION ALL SELECT '102+','Cumulative',102,999 UNION ALL
    SELECT '90.0-91.99','Range',90,92 UNION ALL SELECT '92.0-93.99','Range',92,94 UNION ALL
    SELECT '94.0-95.99','Range',94,96 UNION ALL SELECT '96.0-97.99','Range',96,98 UNION ALL
    SELECT '98.0-99.99','Range',98,100 UNION ALL SELECT '100.0+','Range',100,110
),
Buckets AS (
    SELECT
        PlayerID, PlayerName, FirstName, LastName, Bats,
        PlayerSeasonID, SeasonYear, Age, TeamName, TeamLeague, Division,
        FLOOR(PitchSpeed) AS SpeedBucket,
        COUNT(*) AS Pitches,
        SUM(PitchSpeed) AS SumSpeed,
        SUM(Swing) AS Swings, SUM(Miss) AS Misses, SUM(BallInPlay) AS BallsInPlay,
        SUM(IsSingle) AS Singles, SUM(IsDouble) AS Doubles, SUM(IsTriple) AS Triples,
        SUM(IsHomeRun) AS HomeRuns, SUM(Barrel) AS Barrels, SUM(HardHit) AS HardHits,
        SUM(IsStrikeout) AS Strikeouts, SUM(IsWalk) AS Walks,
        SUM(CASE WHEN BallInPlay = 1 THEN ExitVelocity END) AS EVSum,
        SUM(CASE WHEN BallInPlay = 1 THEN LaunchAngle END) AS LASum
    FROM Velocity_Buckets
    WHERE PitchSpeed >= 90
    GROUP BY PlayerID, PlayerName, FirstName, LastName, Bats,
             PlayerSeasonID, SeasonYear, Age, TeamName, TeamLeague, Division,
             FLOOR(PitchSpeed)
),
AggregatedData AS (
    SELECT
        b.PlayerID, b.PlayerName, b.FirstName, b.LastName, b.Bats,
        b.PlayerSeasonID, b.SeasonYear, b.Age, b.TeamName, b.TeamLeague, b.Division,
        t.VelocityThreshold, t.ThresholdType,
        SUM(b.Pitches) AS TotalPitches,
        SUM(b.Swings) AS Swings, SUM(b.Misses) AS Misses, SUM(b.BallsInPlay) AS BallsInPlay,
        SUM(b.Singles) AS Singles, SUM(b.Doubles) AS Doubles, SUM(b.Triples) AS Triples,
        SUM(b.HomeRuns) AS HomeRuns, SUM(b.Barrels) AS Barrels, SUM(b.HardHits) AS HardHits,
        SUM(b.Strikeouts) AS Strikeouts, SUM(b.Walks) AS Walks,
        SUM(b.EVSum) AS ExitVelocityRaw, SUM(b.LASum) AS LaunchAngleRaw,
        SUM(b.SumSpeed) / SUM(b.Pitches) AS AvgPitchSpeedRaw
    FROM Buckets b
    JOIN Thresholds t ON b.SpeedBucket >= t.MinB AND b.SpeedBucket < t.MaxB
    GROUP BY b.PlayerID, b.PlayerName, b.FirstName, b.LastName, b.Bats,
             b.PlayerSeasonID, b.SeasonYear, b.Age, b.TeamName, b.TeamLeague, b.Division,
             t.VelocityThreshold, t.ThresholdType
)
SELECT
    PlayerID, PlayerName, FirstName, LastName, Bats, PlayerSeasonID, SeasonYear, Age,
    TeamName, TeamLeague, Division, VelocityThreshold, ThresholdType, TotalPitches,
    Singles, Doubles, Triples, HomeRuns,
    (Doubles + Triples + HomeRuns) AS TotalXBH,
    (Singles + Doubles + Triples + HomeRuns) AS TotalHits,
    Swings, Misses, BallsInPlay, Barrels, HardHits, Strikeouts, Walks,
    (BallsInPlay + Strikeouts) AS AtBats,
    (BallsInPlay + Strikeouts + Walks) AS PlateAppearances,
    (Singles + Doubles*2 + Triples*3 + HomeRuns*4) AS TotalBases,
    ROUND(HomeRuns / NULLIF(BallsInPlay + Strikeouts, 0), 3) AS HRPercent,
    ROUND(HomeRuns / NULLIF(Swings, 0), 3) AS HRPerSwingPercent,
    ROUND((Doubles + Triples + HomeRuns) / NULLIF(BallsInPlay + Strikeouts, 0), 3) AS XBHPercent,
    ROUND((Doubles + Triples + HomeRuns) / NULLIF(BallsInPlay, 0), 3) AS XBHPerBIPPercent,
    ROUND(Walks / NULLIF(BallsInPlay + Strikeouts + Walks, 0), 3) AS WalkPercent,
    ROUND(Strikeouts / NULLIF(BallsInPlay + Strikeouts + Walks, 0), 3) AS StrikeoutPercent,
    ROUND((Singles + Doubles + Triples + HomeRuns) / NULLIF(BallsInPlay + Strikeouts, 0), 3) AS BattingAvg,
    ROUND((Singles + Doubles + Triples + HomeRuns + Walks) / NULLIF(BallsInPlay + Strikeouts + Walks, 0), 3) AS OnBasePercentageAvg,
    ROUND((Singles + Doubles*2 + Triples*3 + HomeRuns*4) / NULLIF(BallsInPlay + Strikeouts, 0), 3) AS SluggingPct,
    ROUND(((Singles + Doubles + Triples + HomeRuns + Walks) / NULLIF(BallsInPlay + Strikeouts + Walks, 0))
        + ((Singles + Doubles*2 + Triples*3 + HomeRuns*4) / NULLIF(BallsInPlay + Strikeouts, 0)), 3) AS OnBasePlusSluggingPercentage,
    ROUND(Swings / NULLIF(TotalPitches, 0), 2) AS SwingPercent,
    ROUND(Misses / NULLIF(Swings, 0), 2) AS WhiffPercent,
    ROUND(Barrels / NULLIF(BallsInPlay, 0), 2) AS BarrelPercent,
    ROUND(HardHits / NULLIF(BallsInPlay, 0), 2) AS HardHitPercent,
    ROUND(ExitVelocityRaw, 1) AS TotalExitVelocity,
    ROUND(LaunchAngleRaw, 1) AS TotalLaunchAngle,
    ROUND(AvgPitchSpeedRaw, 1) AS AvgPitchSpeed
FROM AggregatedData;
